# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API). O ranking online fica desativado
# automaticamente se essas duas variáveis não estiverem preenchidas.
#
# A partir do login/cadastro (ver supabase/schema.sql), essas mesmas duas
# variáveis também são obrigatórias — sem elas o hub (tela principal)
# fica bloqueado de propósito (ver src/auth/session.ts).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Servidor autoritativo do 1v1 online do FutTrool (server/, ver docs do
# multiplayer). Sem essa variável, cai no endereço de produção
# (wss://mateus.sysalmeida.com.br) — só precisa sobrescrever aqui pra testar
# contra um servidor local (npm run start dentro de server/).
VITE_FUTTROOL_WS_URL=ws://localhost:8787

# Domínio do canal de voz (Jitsi self-hosted, ver jitsi/stack.yml) usado
# durante partidas online. Sem essa variável, cai no domínio de produção
# (voz.sysalmeida.com.br).
VITE_JITSI_DOMAIN=voz.sysalmeida.com.br
