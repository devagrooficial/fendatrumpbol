# Copie pra jitsi/.env (nunca committado — ver .gitignore) e preencha os
# valores reais antes de rodar o deploy. Gere as senhas com:
#   openssl rand -hex 24

# Domínio público do canal de voz — precisa de um registro DNS tipo A
# apontando pro IP da VPS (2.25.166.1) ANTES do deploy, senão o Traefik
# não consegue emitir certificado Let's Encrypt (mesmo esquema já usado em
# mateus.sysalmeida.com.br pro server/stack.yml). As duas variáveis abaixo
# têm que apontar pro MESMO domínio — uma é a URL completa (usada pelo
# Jitsi), a outra só o host (usada na regra do Traefik).
JITSI_DOMAIN=voz.sysalmeida.com.br
PUBLIC_URL=https://voz.sysalmeida.com.br

# IP público da VPS — o JVB usa isso pra anunciar o candidato ICE certo.
# Sem isso ele anunciaria só o IP interno da rede overlay do Swarm, que é
# inútil por fora: ninguém atrás de NAT/4G conseguiria trocar áudio.
JVB_ADVERTISE_IPS=2.25.166.1

# Senhas internas — XMPP entre jicofo/jvb/prosody, nunca expostas a
# usuário final, mas mesmo assim não deixe em texto puro versionado.
JICOFO_AUTH_PASSWORD=troque_isso_com_openssl_rand
JVB_AUTH_PASSWORD=troque_isso_tambem_com_openssl_rand
